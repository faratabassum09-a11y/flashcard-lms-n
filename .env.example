MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/flashcard_lms
SESSION_SECRET=put-a-long-random-string-here
PORT=5000
# Timezone used to read scheduled start/end times (default Asia/Kolkata)
TZ=Asia/Kolkata
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
# Used only by `npm run seed:admin`
ADMIN_PASSWORD=choose-a-strong-admin-password
NODE_ENV=production
