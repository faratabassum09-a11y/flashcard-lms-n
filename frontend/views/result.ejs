<% layout('layouts/boilerplate') %>
<%
  const tone = percentage >= 75 ? "var(--ok)" : percentage >= 50 ? "var(--warn)" : "var(--bad)";
  const msg = percentage >= 90 ? "Outstanding work!" : percentage >= 75 ? "Great job!" : percentage >= 50 ? "Good effort — keep going." : "Keep practising, you'll get there.";
%>
<a class="crumb" href="/tests"><%- icon("arrow-left") %>All tests</a>
<div class="card" style="padding:clamp(22px,4vw,36px)">
  <div class="row" style="gap:clamp(20px,4vw,40px)">
    <div class="ring" style="--p:<%= percentage %>;--ring:<%= tone %>;--size:170px">
      <svg viewBox="0 0 36 36"><circle class="track" cx="18" cy="18" r="15.915" pathLength="100"/><circle class="val" cx="18" cy="18" r="15.915" pathLength="100"/></svg>
      <div class="ring-label"><b><%= percentage %>%</b><span>Grade <%= grade.letter %></span></div>
    </div>
    <div class="grow stack" style="min-width:240px;gap:10px">
      <span class="badge badge-accent"><%= test.subject || "Test" %></span>
      <h1><%= test.name %></h1>
      <p class="text-2"><%= msg %></p>
      <div class="row" style="gap:22px">
        <div><div class="muted xs">Marks</div><div class="kpi-value tnum"><%= fmt.num(written) %> <small>/ <%= examMax %></small></div></div>
        <% if (ended && rank) { %><div><div class="muted xs">Rank</div><div class="kpi-value">#<%= rank %> <small>of <%= participants %></small></div></div><% } %>
        <% if (ended && participants > 1) { %><div><div class="muted xs">You beat</div><div class="kpi-value"><%= beats %><small>%</small></div></div><% } %>
      </div>
      <div class="muted xs">Submitted <%= fmt.dateTime(submittedAt) %></div>
    </div>
  </div>
  <div class="row mt-lg" style="margin-top:24px">
    <a class="btn btn-primary" href="/leaderboard<%= ended && test._id ? '?test=' + test._id : '' %>"><%- icon("trophy") %>Leaderboard</a>
    <a class="btn" href="/flashcards/study?filter=learning"><%- icon("zap") %>Keep studying</a>
    <a class="btn btn-ghost" href="/dashboard">Dashboard</a>
  </div>
</div>

<% if (!ended) { %>
  <div class="alert mt" style="margin-top:18px"><%- icon("clock") %><div><b>Your rank and answer review unlock when the test ends.</b> This keeps the test fair for classmates who are still writing it.</div></div>
<% } %>

<% if (ended && top.length) { %>
  <section class="card mt" style="margin-top:18px">
    <div class="card-head"><h2><%- icon("trophy") %>Top of this test</h2><a class="card-link" href="/leaderboard?test=<%= test._id %>">Full leaderboard <%- icon("chevron-right") %></a></div>
    <div class="list">
      <% top.forEach(r => { %>
        <div class="list-item">
          <span class="rank-badge <%= r.rank <= 3 ? 'top' : '' %>"><%= r.rank %></span>
          <div class="grow"><b><%= r.name %> <% if (r.isMe) { %><span class="badge badge-accent">You</span><% } %></b></div>
          <span class="tnum"><b><%= Math.round(r.percent) %>%</b></span>
        </div>
      <% }) %>
    </div>
  </section>
<% } %>

<% if (review && review.length) { %>
  <section class="mt-lg" style="margin-top:28px">
    <div class="page-head" style="margin-bottom:14px"><div><h2 style="font-size:1.3rem">Answer review</h2><p>See where you gained and lost marks.</p></div>
      <div class="row"><span class="badge badge-ok">≥75% full marks</span><span class="badge badge-warn">≥50% half marks</span></div></div>
    <div class="stack">
      <% review.forEach((r, i) => { %>
        <article class="card verdict <%= r.verdict %>">
          <div class="row-between" style="align-items:flex-start;margin-bottom:12px">
            <div class="row"><span class="badge">Q<%= i + 1 %></span>
              <span class="badge <%= r.verdict === 'full' ? 'badge-ok' : r.verdict === 'partial' ? 'badge-warn' : 'badge-bad' %>"><%= r.verdict === "full" ? "Full marks" : r.verdict === "partial" ? "Half marks" : "No marks" %></span></div>
            <span class="tnum"><b><%= fmt.num(fmt.scaled(r.got, total)) %></b><span class="muted"> / <%= fmt.num(fmt.scaled(r.max, total)) %> marks</span> · <%= r.percent %>% match</span>
          </div>
          <p style="font-weight:650;margin-bottom:14px"><%= r.question %></p>
          <div class="grid cols-2">
            <div class="stack" style="gap:6px"><span class="label">Your answer</span><div class="answer-box"><%= r.yours %></div></div>
            <div class="stack" style="gap:6px"><span class="label">Expected answer</span><div class="answer-box correct"><%= r.correct %></div></div>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
<% } %>
